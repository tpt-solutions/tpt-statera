// Copyright (c) 2026 TPT Solutions
//
// tpt-statera — linear-arithmetic model of validate_transfer (todo 1C.01, 1C.02, 1C.03,
// 1D.01, 1D.02, 1D.03). Supersedes the abstract-fee model in transfer_conservation.telos.
//
// ENCODING. The Floor fee is `fee = floor(numer / 10000)` with `numer = amount * bps`.
//   * `numer` is a parameter. The product amount*bps is bilinear and is NOT discharged by
//     the Fourier-Motzkin solver. It is supplied by the caller and is definitional.
//   * `fee` is a parameter constrained by the Floor specification, which is linear in
//     (fee, numer):   fee*10000 <= numer < fee*10000 + 10000.
//     This characterizes floor uniquely, so the proof covers the Floor fee.
//   * `status` is an Account whose balance is 1 on Allow and 0 on Deny. It makes the
//     result observable to `ensures` clauses, which cannot refer to a return value.
//   * The ideal (exact rational) fee is numer/10000. Ideal comparisons are multiplied
//     by 10000, so they stay linear.
//
// PROVED (linear, FM solver):
//   E1 strict conservation: pre_sum == post_sum on both Allow and Deny
//   E2 no overdraft: status==1 implies sender_post >= 0 (and sender_post >= 0 in all cases)
//   E3 directionality: sender never increases, recipient and treasury never decrease
//   E4 Deny is a no-op: status==0 implies all three balances are unchanged
//   E5 bounded rounding (1D.01): on Allow, the credited fee satisfies
//        0 <= ideal_fee - realized_fee < 1   (scaled by 10000)
//   E6 overflow denial (1D.03): recipient+amount > cap or treasury+fee > cap implies Deny
//   E7 restated conservative denial (1D.02, decision AD-5): ideal Deny implies realized Deny,
//        or the ideal shortfall (amount + numer/10000 - sender) is below one unit.
//
// NOT PROVED HERE: the fee formula itself (it is the floor spec, a requires).
//   The `requires` on fee and numer are the Floor specification, not a derivation.
//   Discharging `numer == amount*bps` needs Z3 (`telos verify --solver z3`) and remains open.
//
// Verified: `telos verify proofs/transfer_validator.telos`

@boundary(cpu_bound)
@state(persistent)
module TransferValidator {
    invariant Account {
        balance >= 0
    }

    func validate(mut sender: Account, mut recipient: Account, mut treasury: Account,
                  mut status: Account,
                  amount: Int, bps: Int, numer: Int, fee: Int, cap: Int)
        requires amount >= 0
        requires bps >= 0
        requires numer >= 0
        requires fee >= 0
        requires cap >= 0
        requires fee * 10000 <= numer
        requires numer < fee * 10000 + 10000
        requires sender.balance >= 0
        requires recipient.balance >= 0
        requires treasury.balance >= 0
        requires status.balance == 0
        // E1 strict conservation (both outcomes)
        ensures sender.balance + recipient.balance + treasury.balance
                == old(sender.balance) + old(recipient.balance) + old(treasury.balance)
        // E2 no overdraft
        ensures sender.balance >= 0
        // E3 directionality
        ensures sender.balance <= old(sender.balance)
        ensures recipient.balance >= old(recipient.balance)
        ensures treasury.balance >= old(treasury.balance)
        // E4 Deny is a no-op
        ensures status.balance != 0 || sender.balance == old(sender.balance)
        ensures status.balance != 0 || recipient.balance == old(recipient.balance)
        ensures status.balance != 0 || treasury.balance == old(treasury.balance)
        // E5 bounded rounding on Allow (scaled by 10000)
        ensures status.balance == 0 || (treasury.balance - old(treasury.balance)) * 10000 <= numer
        ensures status.balance == 0 || numer < (treasury.balance - old(treasury.balance)) * 10000 + 10000
        // E6 overflow denial (guard evaluated on pre-state + amount/fee)
        ensures old(recipient.balance) + amount <= cap && old(treasury.balance) + fee <= cap || status.balance == 0
        // E7 restated conservative denial (decision AD-5)
        ensures sender.balance * 10000 >= amount * 10000 + numer || status.balance == 0
                || amount * 10000 + numer - old(sender.balance) * 10000 < 10000
    {
        if bps <= 10000 {
            if sender.balance >= amount {
                if sender.balance >= amount + fee {
                    if old(recipient.balance) + amount <= cap {
                        if cap >= 0 {
                            mutate state {
                                sender.balance = old(sender.balance) - amount - fee;
                                recipient.balance = old(recipient.balance) + amount;
                                treasury.balance = old(treasury.balance) + fee;
                                status.balance = 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
