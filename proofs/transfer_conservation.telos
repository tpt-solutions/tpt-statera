//
// tpt-statera — ideal-layer linear core of validate_transfer (todo 1C.01 partial).
//
// SCOPE (read before citing):
//   * Proves STRICT CONSERVATION and NO OVERDRAFT on the Allow path, for an
//     ABSTRACT fee `fee` that is only constrained to be non-negative and covered
//     by the sender's balance.
//   * It does NOT prove the Floor fee formula fee = floor(amount * bps / 10000).
//     That term is bilinear (amount x bps). The built-in Fourier-Motzkin solver
//     cannot discharge it; it needs `--solver z3`, which this environment lacks.
//     The realization-layer bound (todo 1D.01) and the Deny-on-overflow ensures
//     (todo 1D.03) therefore remain OPEN.
//   * The cap parameter stands in for u64::MAX (the literal exceeds the
//     verifier integer range), so the proof holds for every cap >= 0.
//   * The overflow and solvency guards are modelled as `requires` on the Allow
//     path. In the Rust implementation they are Deny branches. Those branches
//     are exercised by tpt-statera-core tests, not by this proof.
//
// Verified: `telos verify proofs/transfer_conservation.telos`

@boundary(cpu_bound)
@state(persistent)
module TransferConservation {
    invariant Account {
        balance >= 0
    }

    func settle(mut sender: Account, mut recipient: Account, mut treasury: Account,
                amount: Int, fee: Int, cap: Int) -> Int
        requires amount >= 0
        requires fee >= 0
        requires cap >= 0
        requires sender.balance >= amount + fee
        requires recipient.balance + amount <= cap
        requires treasury.balance + fee <= cap
        ensures sender.balance == old(sender.balance) - amount - fee
        ensures recipient.balance == old(recipient.balance) + amount
        ensures treasury.balance == old(treasury.balance) + fee
        ensures sender.balance >= 0
        ensures sender.balance + recipient.balance + treasury.balance
                == old(sender.balance) + old(recipient.balance) + old(treasury.balance)
    {
        mutate state {
            sender.balance = old(sender.balance) - amount - fee;
            recipient.balance = old(recipient.balance) + amount;
            treasury.balance = old(treasury.balance) + fee;
        }
        amount
    }
}
