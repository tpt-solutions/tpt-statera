# ============================================================
# tpt-statera — .gitignore
# Note: Cargo.lock is intentionally NOT ignored (todo 1A.07a:
# pinned TPT dependency versions require a committed lockfile).
# ============================================================

# --- Rust / Cargo build artifacts ---
/target
debug/
release/

# Generated by cargo when building benches/examples outside the workspace
# (uncomment only if you generate them locally)
# benches/data/

# Backup files left by rustc/cargo on failed builds
**/*.rs.bk

# Proof / benchmark / certificate output (regenerable artifacts)
*.proof-output/
certificates/out/
bench-results/
flamegraph*.svg
perf.data*

# Test & coverage output
*.profraw
*.profdata
coverage/
tarpaulin-report.html
lcov.info

# Documentation build output
/doc

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- IDE / editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# --- Operating systems ---
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
.nfs*

# --- Logs & temp ---
*.log
tmp/
temp/

# Bench harness is its own workspace (bench/fm_netting). Its build output is not committed.
bench/fm_netting/target/
bench/fm_netting/Cargo.lock

# Python caches from helper scripts
__pycache__/
*.pyc

